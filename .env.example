# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real ".env" file to GitHub.

# Groq API (primary LLM)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API (fallback LLM)
GOOGLE_API_KEY=your_gemini_api_key_here

# LangSmith (tracing / observability)
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=multi-agent-code-review

# GitHub Personal Access Token (needed to fetch PR data)
GITHUB_TOKEN=your_github_personal_access_token_here

# Local testing only — the PR link github_fetcher.py tests against.
# Kept out of committed code on purpose so no specific repo/PR link
# ever ends up in your public portfolio repo's source files.
TEST_PR_URL=https://github.com/owner/repo/pull/1
